# Copy to .env in this folder and fill in values (.env is gitignored).
# For Colab: use Secrets for HF_TOKEN, HF_HUB_USERNAME, GROQ_API_KEY instead.

GROQ_API_KEY=
# Groq retires model ids periodically; override the default without a code change.
GROQ_MODEL=openai/gpt-oss-20b
HF_TOKEN=
# Your Hugging Face profile name (namespace for model + dataset pushes from train.ipynb)
HF_HUB_USERNAME=

# Optional full repo ids (override auto-built names from HF_HUB_USERNAME)
# HF_MODEL_REPO=myuser/incident-response-grpo
# HF_DATASET_REPO=myuser/incident-response-rollouts
